<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Authors>Victus Battery Guardian Contributors</Authors>
    <Company>Victus Battery Guardian</Company>
    <Product>Victus Battery Guardian</Product>
    <VersionPrefix>0.1.0</VersionPrefix>
    <RepositoryUrl>https://github.com/daoistmadness/victus-battery-guardian</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
