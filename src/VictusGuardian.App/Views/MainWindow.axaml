<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VictusGuardian.App.ViewModels"
        xmlns:m="using:VictusGuardian.Storage.Models"
        x:Class="VictusGuardian.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Victus Battery Guardian"
        Width="1050" Height="720"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <!-- 1. DASHBOARD VIEW -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="16">

          <!-- Stale Warning Banner -->
          <Border Background="#3B2A10" BorderBrush="#F59E0B" BorderThickness="1"
                  CornerRadius="6" Padding="14,10" IsVisible="{Binding IsStale}">
            <TextBlock Text="{Binding StaleWarningText}" Foreground="#FCD34D"
                       FontSize="12" FontWeight="SemiBold" />
          </Border>

          <!-- Overview Cards Grid -->
          <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">

            <!-- Primary Battery Card -->
            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,10,10"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*, Auto">
                  <TextBlock Text="BATTERY OVERVIEW" FontSize="12" FontWeight="SemiBold"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                  <Border Grid.Column="1" Background="{StaticResource CardBorderBrush}"
                          CornerRadius="4" Padding="6,2">
                    <TextBlock Text="{Binding ProvenanceBadge}" FontSize="10"
                               Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold" />
                  </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                  <TextBlock Text="{Binding BatteryPercentage, StringFormat={}{0:F0}%}"
                             FontSize="48" FontWeight="Bold"
                             Foreground="{StaticResource TextPrimaryBrush}" />
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding ChargingStateText}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentGreenBrush}" />
                    <TextBlock Text="{Binding PowerStatusText}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                  </StackPanel>
                </StackPanel>

                <!-- Battery Level Bar -->
                <ProgressBar Value="{Binding BatteryPercentage}" Minimum="0" Maximum="100"
                             Height="10" CornerRadius="5"
                             Foreground="{StaticResource AccentGreenBrush}"
                             Background="{StaticResource CardBorderBrush}" />

                <Grid ColumnDefinitions="*, *">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Time Remaining" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding EstimatedTimeRemainingText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Charge/Discharge Rate" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ChargeRateText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Health Quick Summary Card -->
            <Border Grid.Row="0" Grid.Column="1" Margin="10,0,0,10"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="BATTERY HEALTH" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                  <TextBlock Text="{Binding HealthPercentage, StringFormat={}{0:F1}%}"
                             FontSize="48" FontWeight="Bold"
                             Foreground="{StaticResource AccentCyanBrush}" />
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding HealthRatingText}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Lithium Retention Rating" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                  </StackPanel>
                </StackPanel>

                <Grid ColumnDefinitions="*, *">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Remaining Capacity" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding RemainingCapacityText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Telemetry Updated" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding LastUpdatedText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Active Alerts Card -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
              <StackPanel Spacing="10">
                <TextBlock Text="GUARDIAN ALERTS &amp; RECOMMENDATIONS" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <ItemsControl ItemsSource="{Binding ActiveAlerts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#1A202C" CornerRadius="4" Padding="12,8" Margin="0,4">
                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Hardware Telemetry & Sensor Capabilities Card -->
          <Border Background="{StaticResource CardBackgroundBrush}"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel Spacing="12">
              <TextBlock Text="HARDWARE TELEMETRY &amp; SENSOR CAPABILITIES" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource TextSecondaryBrush}" />

              <Grid ColumnDefinitions="*, *, *">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="Battery Voltage" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                  <TextBlock Text="{Binding VoltageText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />

                  <TextBlock Text="Design Capacity" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
                  <TextBlock Text="{Binding DesignCapacityText}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="Full Charge Capacity" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                  <TextBlock Text="{Binding FullChargeCapacityText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />

                  <TextBlock Text="Cycle Count" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
                  <TextBlock Text="{Binding CycleCountText}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Text="Battery Identity" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                  <TextBlock Text="{Binding BatteryIdentityText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />

                  <TextBlock Text="Active Telemetry Tier" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
                  <TextBlock Text="{Binding ActiveProviderTier}" FontSize="12" Foreground="{StaticResource AccentGreenBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>

              <Separator Background="{StaticResource CardBorderBrush}" Margin="0,6" />

              <TextBlock Text="Supported Sensor Channels:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
              <TextBlock Text="{Binding SupportedSensorsText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

              <TextBlock Text="Unsupported Sensor Channels:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
              <TextBlock Text="{Binding UnsupportedSensorsText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!-- 2. HEALTH VIEW -->
    <DataTemplate DataType="{x:Type vm:HealthViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="20">
          <Border Background="{StaticResource CardBackgroundBrush}"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="24">
            <StackPanel Spacing="16">
              <TextBlock Text="BATTERY WEAR &amp; DEGRADATION ANALYSIS" FontSize="16" FontWeight="Bold"
                         Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBlock Text="{Binding ProvenanceNotice}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />

              <Grid ColumnDefinitions="*, *" Margin="0,16,0,0">
                <StackPanel Grid.Column="0" Spacing="8">
                  <TextBlock Text="Overall Health Score" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding HealthPercentage, StringFormat={}{0:F1}%}" FontSize="54" FontWeight="Black"
                             Foreground="{StaticResource AccentCyanBrush}" />
                  <TextBlock Text="{Binding RatingText, StringFormat=Rating: {0}}" FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="12">
                  <TextBlock Text="Detailed Metrics" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                  <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Estimated Wear:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WearPercentage, StringFormat={}{0:F1}%}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Current Full Capacity:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FullChargeCapacityText}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Factory Design Capacity:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DesignCapacityText}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Cycle Count:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CycleCountText}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4" />
                  </Grid>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!-- 3. CHARGING VIEW -->
    <DataTemplate DataType="{x:Type vm:ChargingViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="20">
          <Border Background="{StaticResource CardBackgroundBrush}"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="24">
            <StackPanel Spacing="16">
              <TextBlock Text="CHARGING THRESHOLDS &amp; LONGEVITY PROFILE" FontSize="16" FontWeight="Bold"
                         Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBlock Text="Protect lithium cells by maintaining optimal charge levels (40% - 80% range recommended)."
                         FontSize="13" Foreground="{StaticResource TextMutedBrush}" />

              <Grid ColumnDefinitions="*, *" Margin="0,16,0,0">
                <StackPanel Grid.Column="0" Spacing="12">
                  <TextBlock Text="Longevity Target" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding LongevityTargetText}" FontSize="36" FontWeight="Bold"
                             Foreground="{StaticResource AccentGreenBrush}" />
                  <ProgressBar Value="{Binding BatteryPercentage}" Minimum="0" Maximum="100" Height="8" CornerRadius="4"
                               Foreground="{StaticResource AccentGreenBrush}" Background="{StaticResource CardBorderBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="12">
                  <TextBlock Text="Longevity Status" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding ThresholdStatusText}" FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RecommendationText}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!-- 4. HISTORY VIEW -->
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="20">
          <Border Background="{StaticResource CardBackgroundBrush}"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="PERSISTED TELEMETRY HISTORY (SQLite WAL)" FontSize="14" FontWeight="Bold"
                             Foreground="{StaticResource TextPrimaryBrush}" />
                  <TextBlock Text="Local database writes are throttled during steady battery states to protect SSD endurance."
                             FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Purge History"
                        Command="{Binding PurgeOldDataCommand}"
                        Background="{StaticResource CardBorderBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Padding="12,6" CornerRadius="4" />
              </Grid>

              <ItemsControl ItemsSource="{Binding RecentReadings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type m:BatteryReadingRecord}">
                    <Border Background="#151C28" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,3">
                      <Grid ColumnDefinitions="140, 60, 100, 90, 80, *">
                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat={}{0:F0}%}"
                                   FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding ChargingState}"
                                   FontSize="12" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding IsAcConnected, StringFormat='AC: {0}'}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding ChargeRateMilliwatts, StringFormat='{}{0:N0} mW'}"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="{Binding IsSimulated, StringFormat='Sim: {0}'}"
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!-- 5. SETTINGS VIEW -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" Spacing="20">
          <Border Background="{StaticResource CardBackgroundBrush}"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="24">
            <StackPanel Spacing="16">
              <TextBlock Text="DEMO MODE &amp; SIMULATION CONFIGURATION" FontSize="16" FontWeight="Bold"
                         Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBlock Text="Adjust simulated battery parameters to evaluate UI behavior across diverse battery scenarios."
                         FontSize="13" Foreground="{StaticResource TextMutedBrush}" />

              <StackPanel Spacing="12" Margin="0,8,0,0">
                <CheckBox Content="Enable Demo Mode (Simulate HP Victus 70 Wh Battery)"
                          IsChecked="{Binding IsDemoMode}"
                          Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold" />
                <TextBlock Text="When disabled, queries physical Windows battery device interfaces (IOCTL / GetSystemPowerStatus)."
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="26,0,0,0" />

                <Separator Background="{StaticResource CardBorderBrush}" Margin="0,8" />

                <TextBlock Text="Simulated Battery Percentage:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                <Slider Minimum="1" Maximum="100" Value="{Binding SimulatedPercentage}"
                        IsEnabled="{Binding IsDemoMode}"
                        Foreground="{StaticResource AccentGreenBrush}" />
                <TextBlock Text="{Binding SimulatedPercentage, StringFormat={}{0:F0}%}" FontWeight="Bold"
                           Foreground="{StaticResource AccentGreenBrush}" />

                <CheckBox Content="Simulate AC Adapter Connected" IsChecked="{Binding SimulatedAcConnected}"
                          IsEnabled="{Binding IsDemoMode}"
                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" />

                <StackPanel Spacing="6" Margin="0,8,0,0">
                  <TextBlock Text="Simulated Rate (Watts):" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                  <Slider Minimum="5" Maximum="80" Value="{Binding SimulatedDischargeRateWatts}"
                          IsEnabled="{Binding IsDemoMode}" />
                  <TextBlock Text="{Binding SimulatedDischargeRateWatts, StringFormat={}{0:F1} W}" FontWeight="Bold"
                             Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                  <Button Content="Apply Simulated Values"
                          Command="{Binding ApplySimulationSettingsCommand}"
                          IsEnabled="{Binding IsDemoMode}"
                          Background="{StaticResource AccentGreenBrush}"
                          Foreground="#000000" FontWeight="SemiBold" Padding="16,8" />
                  <Button Content="Reset to HP Victus Defaults"
                          Command="{Binding ResetDefaultsCommand}"
                          IsEnabled="{Binding IsDemoMode}"
                          Background="{StaticResource CardBorderBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}" Padding="16,8" />
                </StackPanel>

                <TextBlock Text="{Binding SettingsStatusMessage}" FontSize="12"
                           Foreground="{StaticResource AccentGreenBrush}" Margin="0,8,0,0" />
              </StackPanel>

              <Separator Background="{StaticResource CardBorderBrush}" Margin="0,16" />

              <TextBlock Text="STORAGE &amp; LOCAL REPOSITORY" FontSize="14" FontWeight="Bold"
                         Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBlock Text="Local SQLite Database Location:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
              <SelectableTextBlock Text="{Binding DatabasePath}" FontSize="12"
                                   Foreground="{StaticResource AccentCyanBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
  </Window.DataTemplates>

  <!-- Shell Layout: Sidebar Navigation + Content Area -->
  <Grid ColumnDefinitions="240, *">

    <!-- Left Navigation Sidebar -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto, *, Auto">

        <!-- App Brand Header -->
        <StackPanel Grid.Row="0" Margin="20,24,20,24" Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Background="{StaticResource AccentGreenBrush}" CornerRadius="4" Width="24" Height="24">
              <TextBlock Text="V" FontWeight="Black" FontSize="16" Foreground="#000000"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="VICTUS GUARDIAN" FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="HP Victus 15.6 Monitor" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>

        <!-- Navigation Links -->
        <StackPanel Grid.Row="1" Spacing="4" Margin="12,0">
          <Button Content="📊  Overview"
                  Command="{Binding NavigateToAsyncCommand}" CommandParameter="Dashboard"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                  Padding="12,10" CornerRadius="6" />

          <Button Content="❤️  Battery Health"
                  Command="{Binding NavigateToAsyncCommand}" CommandParameter="Health"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                  Padding="12,10" CornerRadius="6" />

          <Button Content="⚡  Charging Status"
                  Command="{Binding NavigateToAsyncCommand}" CommandParameter="Charging"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                  Padding="12,10" CornerRadius="6" />

          <Button Content="📜  Telemetry History"
                  Command="{Binding NavigateToAsyncCommand}" CommandParameter="History"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                  Padding="12,10" CornerRadius="6" />

          <Button Content="⚙️  Demo Settings"
                  Command="{Binding NavigateToAsyncCommand}" CommandParameter="Settings"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                  Padding="12,10" CornerRadius="6" />
        </StackPanel>

        <!-- Bottom Demo Mode Badge & Version -->
        <StackPanel Grid.Row="2" Margin="16,20" Spacing="8">
          <Border Background="{StaticResource DemoBadgeBackgroundBrush}" CornerRadius="4" Padding="8,4"
                  IsVisible="{Binding IsDemoModeActive}">
            <TextBlock Text="DEMO MODE ACTIVE" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource DemoBadgeForegroundBrush}" HorizontalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding AppVersionText}" FontSize="10"
                     Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
        </StackPanel>

      </Grid>
    </Border>

    <!-- Main Content Area -->
    <Grid Grid.Column="1" RowDefinitions="Auto, *">

      <!-- Top Action Bar -->
      <Border Grid.Row="0" Background="{StaticResource SidebarBackgroundBrush}"
              BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1"
              Padding="24,14">
        <Grid ColumnDefinitions="*, Auto, Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedSection}" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
          </StackPanel>

          <Border Grid.Column="1" Background="#261E0A" BorderBrush="{StaticResource DemoBadgeBackgroundBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,16,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding ProviderStatusBanner}"
                       FontSize="11" Foreground="{StaticResource DemoBadgeBackgroundBrush}" FontWeight="SemiBold" />
          </Border>

          <Button Grid.Column="2" Content="🔄 Refresh"
                  Command="{Binding Dashboard.RefreshTelemetryAsyncCommand}"
                  Background="{StaticResource CardBorderBrush}"
                  Foreground="{StaticResource TextPrimaryBrush}"
                  Padding="12,6" CornerRadius="4" />
        </Grid>
      </Border>

      <!-- Active View Content -->
      <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />

    </Grid>

  </Grid>
</Window>
